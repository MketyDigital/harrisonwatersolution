---
const { item }=Astro.props;
---
<article class="card">{item.data.heroImage && <img src={item.data.heroImage} alt={item.data.name}/>}<div class="product-meta">{item.data.category}</div><h3>{item.data.name}</h3><p>{item.data.summary}</p><a href={`/products/${item.data.slug}/`}>View details →</a></article>
