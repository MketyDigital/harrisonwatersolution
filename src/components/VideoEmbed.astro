---
import { normalizeVideoUrl } from '../utils/video.mjs'; const { url,title='Video' }=Astro.props; const video=normalizeVideoUrl(url);
---
{video ? <div class="card"><div style="aspect-ratio:16/9"><iframe src={video.embedUrl} title={title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="width:100%;height:100%;border:0;border-radius:12px"></iframe></div></div> : null}
