---
const { companyName = 'Harrison Water Solution & Machinery Services', logo = '', landing = false } = Astro.props;
const links=[['/','Home'],['/about/','About'],['/products/','Products'],['/services/','Services'],['/projects/','Projects'],['/contact/','Contact'],['/water-business-blueprint/','eBook']];
const validLogo = /^(https?:\/\/|\/[^/])/.test(logo.trim());
---
<header class:list={["site-header", {"landing-header": landing}]}><div class="container nav">{landing ? <div class="brand" data-hws-brand data-hws-company={companyName}><img src={validLogo ? logo : undefined} alt={companyName} class="brand-logo" hidden={!validLogo}/><span class="brand-text" hidden={validLogo}>{companyName}</span></div> : <a class="brand" href="/" data-hws-brand data-hws-company={companyName}><img src={validLogo ? logo : undefined} alt={companyName} class="brand-logo" hidden={!validLogo}/><span class="brand-text" hidden={validLogo}>{companyName}</span></a>}{!landing && <><nav class="nav-links" aria-label="Main navigation">{links.map(([href,label])=><a href={href}>{label}</a>)}</nav><details class="mobile-nav"><summary>Menu</summary><nav>{links.map(([href,label])=><div><a href={href}>{label}</a></div>)}</nav></details></>}</div></header>
