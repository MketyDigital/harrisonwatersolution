---
import { getCollection,getEntry } from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro'; import ProductCard from '../components/ProductCard.astro'; import ServiceCard from '../components/ServiceCard.astro'; import ButtonLink from '../components/ButtonLink.astro';
const home=(await getEntry('pages','home'))?.data; const site=(await getEntry('settings','site'))?.data; const products=(await getCollection('products')).filter(x=>x.data.featured).sort((a,b)=>a.data.order-b.data.order).slice(0,3); const services=(await getCollection('services')).filter(x=>x.data.featured).sort((a,b)=>a.data.order-b.data.order).slice(0,3);
---
<BaseLayout><main data-hws-page="home"><section class="hero"><div class="container hero-grid"><div><div class="eyebrow">{home.hero.eyebrow}</div><h1>{home.hero.heading}</h1><p class="lead">{home.hero.text}</p><div class="actions"><ButtonLink href={site.contact?.whatsapp||'/contact/'} label={home.hero.primaryCta}/><ButtonLink href="/products/" label={home.hero.secondaryCta} secondary={true}/></div></div><div class="hero-panel"><div><div class="eyebrow">Harrison Water Solution</div><h2>Plan the system, machinery and production flow together.</h2><p>Real project and equipment imagery can be uploaded from the admin dashboard.</p></div></div></div></section><section class="section"><div class="container"><div class="eyebrow">Services</div><h2>{home.servicesHeading}</h2><div class="grid grid-3">{services.map(item=><ServiceCard item={item}/>)}</div></div></section><section class="section section-soft"><div class="container"><div class="eyebrow">Products</div><h2>{home.productsHeading}</h2><div class="grid grid-3">{products.map(item=><ProductCard item={item}/>)}</div></div></section><section class="section"><div class="container grid grid-2"><div><div class="eyebrow">Why Harrison</div><h2>{home.whyHeading}</h2></div><div class="feature-list">{home.whyItems.map(item=><div class="feature"><h3>{item.title}</h3><p>{item.text}</p></div>)}</div></div></section><section class="section section-soft"><div class="container"><div class="eyebrow">Process</div><h2>{home.processHeading}</h2><div class="grid grid-3">{home.process.map((item,i)=><div class="card"><div class="number">0{i+1}</div><h3>{item.title}</h3><p>{item.text}</p></div>)}</div></div></section><section class="section"><div class="container"><h2>{home.ctaHeading}</h2><p class="lead">{home.ctaText}</p><div class="actions"><ButtonLink href={site.contact?.whatsapp||'/contact/'} label="Request a Quote"/></div></div></section></main></BaseLayout>
