---
import { getCollection,getEntry } from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro'; import ButtonLink from '../components/ButtonLink.astro'; import VideoEmbed from '../components/VideoEmbed.astro'; import { resolvePaymentUrl } from '../utils/payment.mjs';
const ebook=(await getEntry('pages','ebook'))?.data; const projects=(await getCollection('projects')).filter(x=>x.data.featured!==false).slice(0,6); const testimonials=(await getCollection('testimonials')).filter(x=>x.data.featured!==false).slice(0,8); const videos=(await getCollection('videos')).filter(x=>x.data.url).slice(0,4); const faqs=(await getCollection('faqs')).filter(x=>x.data.category==='ebook').sort((a,b)=>(a.data.order||99)-(b.data.order||99)); const buyUrl=resolvePaymentUrl({nigeriaUrl:ebook.nigeriaPaymentUrl,internationalUrl:ebook.internationalPaymentUrl,primaryUrl:ebook.primaryPaymentUrl},'default');
---
<BaseLayout title={`${ebook.title} | Harrison Water Solution`} description={ebook.hero.text}><main data-hws-page="ebook"><div style="background:#dff7fb;text-align:center;padding:.65rem 1rem;font-weight:800">{ebook.announcement}</div><section class="ebook-hero"><div class="container hero-grid"><div><div class="eyebrow">{ebook.hero.eyebrow}</div><h1>{ebook.hero.heading}</h1><p class="lead">{ebook.hero.text}</p><div class="actions"><ButtonLink href={buyUrl} label={ebook.buyButtonLabel}/></div><p style="margin-top:1rem">Instant digital access after payment once the checkout workflow is configured.</p></div><div class="pricing"><div class="product-meta">Digital guide</div><div class="price">{ebook.price}</div><h2>Complete Pure Water Business Blueprint</h2><p>Factory planning, treatment, machinery, costing, operations and growth in one practical guide.</p><ButtonLink href={buyUrl} label={ebook.buyButtonLabel}/></div></div></section><section class="section"><div class="container grid grid-2"><div><div class="eyebrow">The problem</div><h2>{ebook.painHeading}</h2></div><div>{ebook.painPoints.map(x=><div class="feature">✓ {x}</div>)}</div></div></section><section class="section section-soft"><div class="container"><div class="eyebrow">Introducing the guide</div><h2>{ebook.introHeading}</h2><p class="lead">{ebook.introText}</p><div class="ebook-highlight"><strong>{ebook.authorHeading}</strong><p>{ebook.authorText}</p></div></div></section><section class="section"><div class="container"><div class="eyebrow">Inside the book</div><h2>{ebook.benefitsHeading}</h2><div class="grid grid-2">{ebook.benefits.map(x=><div class="card">✓ {x}</div>)}</div><div class="actions"><ButtonLink href={buyUrl} label={ebook.buyButtonLabel}/></div></div></section><section class="section section-soft"><div class="container"><div class="eyebrow">See what you are getting</div><h2>Practical previews that help you plan before spending</h2><div class="grid grid-2">{ebook.previews.map((x,i)=><article class="card preview"><div class="number">0{i+1}</div><h3>{x.title}</h3><p>{x.text}</p></article>)}</div></div></section>{videos.length>0&&<section class="section"><div class="container"><div class="eyebrow">Video</div><h2>{ebook.videosHeading}</h2><div class="grid grid-2">{videos.map(v=><VideoEmbed url={v.data.url} title={v.data.title}/>)}</div></div></section>}<section class="section"><div class="container grid grid-2"><div><div class="eyebrow">Who it is for</div><h2>{ebook.whoHeading}</h2></div><div>{ebook.whoItems.map(x=><div class="feature">✓ {x}</div>)}</div></div></section>{projects.length>0&&<section class="section section-soft"><div class="container"><div class="eyebrow">Work done</div><h2>{ebook.workHeading}</h2><div class="gallery">{projects.flatMap(p=>p.data.gallery||[]).slice(0,9).map(img=><img src={img.image} alt={img.alt}/>)}</div></div></section>}{testimonials.length>0&&<section class="section"><div class="container"><div class="eyebrow">Proof</div><h2>{ebook.testimonialsHeading}</h2><div class="grid grid-3">{testimonials.map(t=><blockquote class="card"><p class="quote">“{t.data.quote}”</p><footer><strong>{t.data.name}</strong>{t.data.location&&<span> · {t.data.location}</span>}</footer></blockquote>)}</div></div></section>}<section class="section section-soft"><div class="container grid grid-2"><div><div class="eyebrow">Included</div><h2>{ebook.bonusHeading}</h2></div><div>{ebook.bonuses.map(x=><div class="feature">✓ {x}</div>)}</div></div></section><section class="section"><div class="container"><div class="eyebrow">FAQ</div><h2>{ebook.faqHeading}</h2>{faqs.map(f=><details class="card" style="margin-bottom:.75rem"><summary><strong>{f.data.question}</strong></summary><p>{f.data.answer}</p></details>)}</div></section><section class="section section-soft"><div class="container grid grid-2"><div><h2>{ebook.finalHeading}</h2><p class="lead">{ebook.finalText}</p></div><div class="pricing"><div class="price">{ebook.price}</div><p>One practical guide. Read it on your phone or computer.</p><ButtonLink href={buyUrl} label={ebook.buyButtonLabel}/></div></div></section><div class="sticky-buy"><ButtonLink href={buyUrl} label={`${ebook.buyButtonLabel} — ${ebook.price}`}/></div></main></BaseLayout>
