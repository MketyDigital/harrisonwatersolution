---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout landing title="Water Production Business Training | Harrison Water Solution" description="Learn to plan, start and improve a sachet or bottled water production business with practical industry guidance.">
<main data-hws-page="training" class="water-training">
  <section class="wt-hero"><div class="container wt-hero-grid"><div><div class="wt-kicker">Harrison Water Solution & Machinery Services</div><h1>MASTER THE WATER PRODUCTION BUSINESS — BEFORE YOU INVEST YOUR MONEY!</h1><p class="wt-lead">Understand equipment, water treatment, NAFDAC planning, costs and business opportunities before you start or expand.</p><div class="wt-actions"><a class="button" href="/contact/">Register for Training</a><a class="wt-link" href="#proof">See our work ↓</a></div><p class="wt-small">For aspiring entrepreneurs, existing factory owners and those exploring opportunities without factory capital.</p></div><div class="wt-visual"><div class="wt-visual-fallback"><span>WATER PRODUCTION</span><strong>LEARN • PLAN • GROW</strong></div></div></div></section>
  <section class="wt-section"><div class="container"><h2>What you'll learn</h2><div class="wt-benefit-grid"><div class="wt-benefit">✓ Water treatment and testing</div><div class="wt-benefit">✓ Machines and genuine equipment</div><div class="wt-benefit">✓ Factory layout and NAFDAC planning</div><div class="wt-benefit">✓ Capital, risks and profit factors</div></div></div></section>
  <section class="wt-section" id="proof"><div class="container"><h2>See our work</h2><p>Explore our <a href="/projects/">water treatment and machinery projects</a>.</p></div></section>
  <section class="wt-final"><div class="container"><h2>Learn first. Make informed decisions.</h2><a class="button" href="/contact/">Register for Training</a></div></section>
</main>
<link rel="stylesheet" href="/css/water-training.css" />
</BaseLayout>
