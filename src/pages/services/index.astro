---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import ServiceCard from '../../components/ServiceCard.astro'; const items=(await getCollection('services')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="Services | Harrison Water Solution"><main data-hws-page="services"><section class="hero"><div class="container"><div class="eyebrow">Services</div><h1>From treatment planning to factory setup support</h1><p class="lead">Service details remain editable as Harrison’s verified scope expands.</p></div></section><section class="section"><div class="container grid grid-3">{items.map(item=><ServiceCard item={item}/>)}</div></section></main></BaseLayout>
