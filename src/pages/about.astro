---
import { getEntry } from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro'; const about=(await getEntry('pages','about'))?.data;
---
<BaseLayout title={`${about.title} | Harrison Water Solution`}><main><section class="hero"><div class="container"><div class="eyebrow">About</div><h1>{about.heading}</h1><p class="lead">{about.intro}</p></div></section><section class="section"><div class="container grid grid-2"><div><h2>Practical, project-focused support</h2><p>{about.body}</p></div><div class="card"><h3>Areas the website is structured to present</h3><ul>{about.expertise.map(x=><li>{x}</li>)}</ul></div></div></section></main></BaseLayout>
