---
import { getEntry } from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro'; import ButtonLink from '../components/ButtonLink.astro'; const page=(await getEntry('pages','contact'))?.data; const site=(await getEntry('settings','site'))?.data;
---
<BaseLayout title={`${page.title} | Harrison Water Solution`}><main data-hws-page="contact"><section class="hero"><div class="container"><div class="eyebrow">Contact</div><h1>{page.heading}</h1><p class="lead">{page.text}</p><div class="actions">{site.contact?.whatsapp&&<ButtonLink href={site.contact.whatsapp} label="WhatsApp Us"/>}{site.contact?.phone&&<ButtonLink href={`tel:${site.contact.phone}`} label="Call Us" secondary={true}/>}</div></div></section><section class="section"><div class="container grid grid-2"><div class="card"><h3>Project details to send</h3><ul><li>Your location</li><li>Sachet, bottled water or other application</li><li>Expected production capacity</li><li>New factory, upgrade or repair</li><li>Equipment already available, if any</li></ul></div><div class="card"><h3>Contact details</h3>{site.contact?.email?<p><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>:<p>Email will appear here once configured.</p>}{site.contact?.address&&<p>{site.contact.address}</p>}</div></div></section></main></BaseLayout>
