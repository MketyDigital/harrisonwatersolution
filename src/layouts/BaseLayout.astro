---
import { getEntry } from 'astro:content'; import SiteHeader from '../components/SiteHeader.astro'; import SiteFooter from '../components/SiteFooter.astro'; import '../styles/global.css'; import '../styles/components.css';
const siteEntry=await getEntry('settings','site'); const site=siteEntry?.data || {}; const { title=site.seo?.title||site.companyName, description=site.seo?.description||'', image=site.seo?.shareImage||'', noindex=false }=Astro.props; const canonical=new URL(Astro.url.pathname, site.siteUrl||Astro.site).toString();
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href={site.favicon||'/favicon.svg'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/>{image && <meta property="og:image" content={new URL(image,site.siteUrl||Astro.site).toString()}/>}<meta name="twitter:card" content="summary_large_image"/>{noindex && <meta name="robots" content="noindex,nofollow"/>}</head><body style={`--brand-primary:${site.brand?.primary||'#087a96'};--brand-secondary:${site.brand?.secondary||'#123b4a'};--brand-accent:${site.brand?.accent||'#0ca6c9'}`}><SiteHeader companyName={site.companyName}/><slot/><SiteFooter site={site}/></body></html>
